# Put ONE of these keys, or use CF_PROVIDER=ollama for free local models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider: picked from whichever key is set, or force it: openai | anthropic | ollama
# CF_PROVIDER=ollama

# Models (defaults: OpenAI gpt-5.4-mini for every step; Ollama qwen3-vl:8b; Anthropic claude-opus-5-5)
# CF_MODEL=gpt-5.5              # analysis + drafting (the hard steps)
# CF_EXTRACT_MODEL=gpt-5.4-mini # reading facts off documents (the easy step)

# Reasoning effort per step: low | medium | high
# CF_EFFORT_EXTRACT=low
# CF_EFFORT_ANALYSE=medium
# CF_EFFORT_DRAFT=low

# Local models
# CF_OLLAMA_URL=http://localhost:11434
# CF_OLLAMA_NUM_CTX=16384

# Prices for cost tracking, USD per 1M tokens [input, cached input, output]; built-ins are in app/usage.py
# CF_PRICES={"some-model": [1.0, 0.1, 4.0]}

# Other
# CF_DATA_DIR=./data
# CF_RETENTION_DAYS=30
# CF_MAX_UPLOAD_MB=20
# CF_CORS_ORIGINS=http://localhost:5173
# CF_DEMO=1                     # canned sample responses, no AI calls at all

# Production (see DEPLOY.md)
# CF_ENV=prod                     # secure cookies; sign-in requires SMTP
# CF_ADMIN_EMAILS=you@example.com # who can see /#/admin
# CF_DAILY_BUDGET_USD=2           # stop new AI work after this spend per day
# CF_MAX_CASES_PER_USER_DAY=5
# CF_PUBLIC_URL=https://your-site    # links in reminder emails
# CF_REMINDERS=1                   # hourly deadline reminder emails (0 = off)
# CF_SMTP_HOST=smtp-relay.brevo.com
# CF_SMTP_PORT=587
# CF_SMTP_USER=
# CF_SMTP_PASSWORD=
# CF_EMAIL_FROM=ClaimFighter <you@example.com>
# (Without CF_SMTP_HOST in dev, sign-in codes are printed in the server log.)
